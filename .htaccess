# EcomGrowthIA — reglas para Hostinger (LiteSpeed/Apache).
# Reproducen lo que hacía vercel.json: cleanUrls=true y trailingSlash=false.
# HTTPS se fuerza desde hPanel (Seguridad → SSL → Forzar HTTPS), no aquí:
# detrás de la CDN de Hostinger, %{HTTPS} puede no reflejar la petición original.

Options -Indexes -MultiViews
DirectorySlash Off
DirectoryIndex index.html
RewriteEngine On
RewriteBase /

# 0. No servir ficheros internos del repositorio (.git, .env.example, .htaccess…)
#    .well-known queda permitido: lo usa la emisión del certificado SSL.
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^(vercel\.json|README\.md)$ - [F,L]

# 1. ecomgrowthia.com → www.ecomgrowthia.com (la versión canónica de siempre)
RewriteCond %{HTTP_HOST} ^ecomgrowthia\.com$ [NC]
RewriteRule ^ https://www.ecomgrowthia.com%{REQUEST_URI} [R=301,L]

# 2. /index.html → /   y   /pagina.html → /pagina   (solo peticiones del navegador)
RewriteCond %{THE_REQUEST} \s/+(.*?)/?index\.html[\s?] [NC]
RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L]

# 3. Sin barra final: /servicios/ → /servicios
RewriteRule ^(.+)/$ https://%{HTTP_HOST}/$1 [R=301,L]

# 4. /carpeta → carpeta/index.html (interno, sin redirección)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ $1/index.html [L]

# 5. /pagina → pagina.html (interno, sin redirección)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
